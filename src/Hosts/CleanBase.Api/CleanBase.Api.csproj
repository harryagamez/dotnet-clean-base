<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>cleanbase-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CleanBase.Application\CleanBase.Application.csproj" />
    <!-- The host is the composition root: it is the only place allowed to know about Infrastructure. -->
    <ProjectReference Include="..\..\CleanBase.Infrastructure\CleanBase.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Needed only by the dotnet-ef tool, which uses this project as its startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
